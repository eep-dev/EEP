  "description": "Standard Webhooks HMAC-SHA256 signing and verification for EEP-compliant platforms.",
  "license": "Apache-2.0",
  "author": "The EEP Authors and Contributors <hello@eep.dev> (https://eep.dev)",
  "homepage": "https://github.com/eep-dev/EEP/tree/main/packages/@eep-dev/signer#readme",
  "repository": {
    "type": "git",
