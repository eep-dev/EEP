  "description": "EEP discovery utilities \u2014 manifest validation, Link header parsing, DNS TXT record parsing",
  "license": "Apache-2.0",
  "author": "The EEP Authors and Contributors <hello@eep.dev> (https://eep.dev)",
  "homepage": "https://github.com/eep-dev/EEP/tree/main/packages/@eep-dev/discovery#readme",
  "repository": {
    "type": "git",
